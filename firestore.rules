rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /ranking/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid && valid();
      allow update: if request.auth != null && request.auth.uid == uid && valid()
                    && request.resource.data.ms <= resource.data.ms;
      allow delete: if false;
    }
    function valid() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'ms', 'date'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 20
        && d.ms is int && d.ms >= 3000 && d.ms < 3600000
        && d.date is string && d.date.size() <= 40;
    }
  }
}
